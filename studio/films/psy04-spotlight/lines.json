[
 {
  "id": "P01",
  "text": "You walk in, and you're sure everyone noticed.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P02",
  "text": "The stain.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P03",
  "text": "The awkward wave.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P04",
  "text": "The voice crack.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P05",
  "text": "But here's the thing:",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P06",
  "text": "they almost certainly didn't.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P07",
  "text": "In two thousand, Cornell psychologists sent students into a room",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P08",
  "text": "wearing a T-shirt with a cheesy pop star's face on it.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P09",
  "text": "Then they asked: how many people noticed?",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P10",
  "text": "The students guessed about half the room.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P11",
  "text": "The real answer? About one in four.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P12",
  "text": "It's called the spotlight effect.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P13",
  "text": "You feel like you're on stage, under a giant light.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P14",
  "text": "But everyone else is starring in their own show,",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P15",
  "text": "worrying about their own stain.",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P16",
  "text": "So next time you feel watched,",
  "voice": "am_michael",
  "speed": 1.0
 },
 {
  "id": "P17",
  "text": "remember: you're the only one holding the spotlight.",
  "voice": "am_michael",
  "speed": 1.0
 }
]